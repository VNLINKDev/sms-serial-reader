APP_NAME=sms-serial-reader
APP_IMAGE=sms-serial-reader
APP_VERSION=1.0.0
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError

# Đường dẫn thiết bị serial Linux cho modem GSM.
# Giá trị thường dùng: /dev/ttyUSB0, /dev/ttyUSB1, /dev/ttyACM0.
SERIAL_DEVICE=/dev/ttyUSB0
SERIAL_PORT=/dev/ttyUSB0
BAUD_RATE=115200

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_QUEUE_NAME=sms:incoming

# Giá trị hỗ trợ: VALUE
REDIS_MODE=VALUE
REDIS_PUBLISH_RETRIES=3

DELETE_SMS_AFTER_READ=false
UNREAD_POLL_INTERVAL_MS=60000
POLL_INTERVAL_MS=100
# Khi số SMS trên SIM >= ngưỡng này, tự động xóa tin cũ
SIM_HIGH_WATERMARK=20
# Số tin nhắn gần nhất giữ lại sau cleanup (dùng để debug/retry khi lỗi)
SIM_KEEP_RECENT=5

# Telegram Notification (gửi OTP lên Telegram group khi nhận SMS)
# Bật tính năng: TELEGRAM_ENABLED=true
# Lấy bot token từ @BotFather trên Telegram
# Chat ID: dùng @userinfobot hoặc Telegram API để lấy ID của group/channel
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_group_chat_id_here

# Patterns định vị và giải mã tin nhắn SMS
# Pattern phát hiện vị trí tin nhắn mới khi modem báo +CMTI (vd: +CMTI: "SM",12)
SMS_INDEX_CMTI_PATTERN=\+CMTI:\s*"[^"]+",(\d+)
# Pattern lấy danh sách chỉ số tin nhắn chưa đọc từ bộ nhớ modem (vd: +CMGL: 1,...)
SMS_INDEX_CMGL_PATTERN=\+CMGL:\s*(\d+),
# Pattern giải mã lấy Mã giao dịch và mã OTP từ nội dung SMS
SMS_OTP_PATTERN=Ma\s+giao\s+dich\s+(\d+).*?OTP\s*:?\s*(\d+)

MANAGEMENT_ENDPOINTS=health,info,prometheus
MANAGEMENT_HEALTH_SHOW_DETAILS=when_authorized
LOG_PATH=/app/logs
LOG_LEVEL=INFO
LOG_MAX_FILE_SIZE=50MB
LOG_MAX_HISTORY=14
LOG_TOTAL_SIZE_CAP=2GB

BACKUP_DIR=./backups
NGINX_SERVER_NAME=_
TLS_CERT_PATH=/etc/nginx/certs/fullchain.pem
TLS_KEY_PATH=/etc/nginx/certs/privkey.pem
