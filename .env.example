# JVM
JAVA_OPTS="-Xms64m -Xmx256m -XX:+UseSerialGC -Xss256k -XX:TieredStopAtLevel=1 -XX:+ExitOnOutOfMemoryError"

# Modem và SIM
# Khi chạy trực tiếp ngoài Docker, đặt đường dẫn thật như /dev/ttyUSB0 hoặc COM5.
# Khi chạy bằng Docker Compose, giá trị này được ghi đè thành /dev/modem.
SERIAL_PORT=/dev/ttyUSB0
BAUD_RATE=115200
PHONE_NUMBER=so_dien_thoai_cua_sim

# SMS keep-alive
KEEP_ALIVE_SMS_CONTENT=OTP
KEEP_ALIVE_PHONE_NUMBER=so_dien_thoai_nhan_sms_keep_alive
KEEP_ALIVE_SMS_INTERVAL_DAYS=5
# -1: gửi lần đầu theo đúng chu kỳ; có thể đặt 30 để thử sau 30 giây.
KEEP_ALIVE_SMS_INITIAL_DELAY_SECONDS=-1

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_QUEUE_NAME=telecom_vinaphone_sms_otp:incoming
REDIS_LATEST_KEY=telecom_vinaphone_sms_otp:latest
# Giá trị hỗ trợ: VALUE, LIST
REDIS_MODE=LIST
REDIS_PUBLISH_RETRIES=3
REDIS_TIMEOUT_MS=10000

# Đọc, parse và dọn dẹp SMS
DELETE_SMS_AFTER_READ=false
UNREAD_POLL_INTERVAL_MS=60000
SIM_HIGH_WATERMARK=20
SIM_KEEP_RECENT=5
SMS_INDEX_CMGL_PATTERN=\\+CMGL:\\s*(\\d+),
SMS_OTP_PATTERN=Ma\\s+giao\\s+dich\\s+(\\d+).*?OTP\\s*:?\\s*(\\d+)

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_group_chat_id_here

# Logging
LOG_PATH=/app/logs
LOG_LEVEL=INFO
LOG_MAX_FILE_SIZE=50MB
LOG_MAX_HISTORY=14
LOG_TOTAL_SIZE_CAP=2GB
