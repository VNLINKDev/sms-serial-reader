APP_NAME=sms-serial-reader
APP_IMAGE=sms-serial-reader
APP_VERSION=1.0.0
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError

# Đường dẫn thiết bị serial Linux cho modem GSM.
# Giá trị thường dùng: /dev/ttyUSB0, /dev/ttyUSB1, /dev/ttyACM0.
SERIAL_DEVICE=/dev/ttyUSB0
SERIAL_PORT=/dev/ttyUSB0
BAUD_RATE=115200

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_QUEUE_NAME=sms:incoming
# Giá trị hỗ trợ: VALUE, PUBSUB.
# VALUE lưu JSON SMS đã phân tích mới nhất bằng Redis SET.
# PUBSUB phát từng JSON SMS đã phân tích lên kênh Redis.
REDIS_MODE=VALUE
REDIS_PUBLISH_RETRIES=3

DELETE_SMS_AFTER_READ=false
UNREAD_POLL_INTERVAL_MS=60000

MANAGEMENT_ENDPOINTS=health,info,prometheus
MANAGEMENT_HEALTH_SHOW_DETAILS=when_authorized
LOG_PATH=/app/logs
LOG_LEVEL=INFO
LOG_MAX_FILE_SIZE=50MB
LOG_MAX_HISTORY=14
LOG_TOTAL_SIZE_CAP=2GB

BACKUP_DIR=./backups
NGINX_SERVER_NAME=_
TLS_CERT_PATH=/etc/nginx/certs/fullchain.pem
TLS_KEY_PATH=/etc/nginx/certs/privkey.pem
